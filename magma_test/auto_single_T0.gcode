;WIPE_END
M107
;===================================================
; MAGMA INJECTION (auto, magma_inject.py)
; cavity 100.0 mm^2 x 10.00 mm = 1000 mm^3  ->  inject 1000 mm^3 (100%)
; XY 180.000,180.000  rim z=12.00  plunge 2.0mm -> z=10.00
; 240C  flow 15.0 mm^3/s  E=415.8mm in 3x138.58mm @ F374
;===================================================
M83 ; relative E
M104 S240                 ; heat inject tool T0
M109 S240                 ; wait
G1 Z20 F600                ; lift clear
G1 X180.000 Y180.000 F9000   ; travel to injection point
G1 Z12.000 F600          ; descend to cavity rim
G1 Z10.000 F60         ; plunge 2.0mm
G1 E0.8 F2100             ; prime
; --- inject 1000 mm^3 ---
G1 E138.584 F374
G1 E138.584 F374
G1 E138.584 F374
G4 P800
G1 E-1.5 F2100            ; retract
G1 Z40 F600                ; lift back up
;===================== END MAGMA INJECTION =========
;TYPE:Custom
; Filament-specific end gcode
; Filament-specific end gcode
G4 ; wait

G1 Z17 ; Move bed down

P0 S1 ; park tool

G1 Z109 F300 ; Move bed further down

; turn off extruder heaters
M104 T0 S0





M140 S0 ; turn off heatbed
M107 ; turn off fan
M221 S100 ; reset flow percentage
M84 ; disable motors
M77 ; stop print timer
; max_layer_z = 12
