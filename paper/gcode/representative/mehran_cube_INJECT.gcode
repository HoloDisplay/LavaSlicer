;TYPE:Custom
; filament end gcode 
; filament end gcode 
; filament end gcode 
; filament end gcode 
; filament end gcode 
G4 ; wait

G1 Z24.6 ; Move bed down

P0 S1 ; park tool

G1 Z116.6 F300 ; Move bed further down

; turn off extruder heaters
 M104 T0 S0 





M140 S0 ; turn off heatbed
M107 ; turn off fan
M221 S100 ; reset flow percentage
M84 ; disable motors
M77 ; stop print timer
; max_layer_z = 19.6
M73 P100 R0
; EXECUTABLE_BLOCK_END

; filament used [mm] = 353.80, 0.00, 0.00, 0.00, 0.00
; filament used [cm3] = 0.85, 0.00, 0.00, 0.00, 0.00
;===================================================
; MAGMA INJECTION (auto, magma_inject.py)
; cavity 124.8 mm^2 max x ~16.20 mm = 936 mm^3  ->  inject 936 mm^3
; XY 179.902,179.901  rim z=19.60  plunge 2.0mm -> z=17.60
; 240C  flow 25.0 mm^3/s  E=389.2mm in 3x129.72mm @ F624
;===================================================
M83 ; relative E
M104 S240                 ; heat inject tool T0
M109 S240                 ; wait
G1 Z20 F600                ; lift clear
G1 X179.902 Y179.901 F9000   ; travel to injection point
G1 Z19.600 F600          ; descend to cavity rim
G1 Z17.600 F60         ; plunge 2.0mm
G1 E0.8 F2100             ; prime
; --- inject 936 mm^3 ---
G1 E129.722 F624
G1 E129.722 F624
G1 E129.722 F624
G4 P800
G1 E-1.5 F2100            ; retract
G1 Z40 F600                ; lift back up
;===================== END MAGMA INJECTION =========
